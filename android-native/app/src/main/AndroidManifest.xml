<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 桌面歌词浮窗的前台身份（w3-A 任务 5 建议 2）：specialUse 类型 + 用途属性 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.XunyinNative"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- S18 deeplink：lxmusic://<type>/<action>/...（对照 RN src/core/init/deeplink） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lxmusic" />
            </intent-filter>
            <!-- 列表文件打开：只认 json（lxmc 无标准 MIME，靠应用内导入，见 lane 报告遗留） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="content"
                    android:mimeType="application/json" />
            </intent-filter>
            <!-- lxmc（gzip JSON 无标准 MIME）：对照 RN manifest 用 octet-stream + 扩展名
                 pathPattern 组合拦截；content:// 拿不到扩展名时仍由应用内导入兜底 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\.lxmc" />
                <data android:pathPattern=".*\..*\.lxmc" />
                <data android:pathPattern=".*\..*\..*\.lxmc" />
                <data android:pathSuffix=".lxmc" />
            </intent-filter>
            <!-- 五源歌单网页外部直达（W8-C）：host 白名单 = SonglistLinkParser 能解析的
                 五源域名（kw/kg/tx/wy/mg），解析失败留在浏览器，由 DeeplinkParser 收口 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="www.kuwo.cn" />
                <data android:host="www.kugou.com" />
                <data android:host="y.qq.com" />
                <data android:host="music.163.com" />
                <data android:host="music.migu.cn" />
            </intent-filter>
        </activity>

        <service
            android:name=".player.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- 桌面歌词浮窗：specialUse 前台服务（用途 = 展示正在播放歌曲的桌面歌词）。
             不用 mediaPlayback：本服务不持有播放器，只有浮窗身份；
             不用 dataSync：Android 15 起有 6 小时运行上限，mediaPlayback 无限时。 -->
        <service
            android:name=".lyric.DesktopLyricService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Desktop lyric overlay for the currently playing track" />
        </service>

        <!-- W5-11 分享不落相册：分享卡先写 cacheDir/share_cache，经 FileProvider 以 content:// 分享。
             只暴露 cache 子目录（外部拿不到别的路径）；保存到相册仍走 MediaStore。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
